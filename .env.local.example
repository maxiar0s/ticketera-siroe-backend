PORT=5000

# Base de datos local Docker (service: mysql)
DB_DATABASE_NAME=ticketera_local
DB_USER=ticketera
DB_HOST=mysql
DB_PORT=3306
DB_PASSWORD=ticketera123

# JWT
JWT_SECRETPASSWORD=local_dev_secret_change_me

# Google Cloud Storage (opcional en local)
GCLOUD_PROJECT_ID=local-dev
GCLOUD_KEY_FILE=./config/local-service-account.json
GCLOUD_BUCKET_NAME=local-bucket

### Integracion de Tickets Inbound por Email (deshabilitada en local) ###
TICKET_INBOUND_ENABLED=false
TICKET_INBOUND_IMAP_HOST=imap.local
TICKET_INBOUND_IMAP_PORT=993
TICKET_INBOUND_IMAP_SECURE=true
TICKET_INBOUND_IMAP_USER=local@example.com
TICKET_INBOUND_IMAP_PASSWORD=local-password
TICKET_INBOUND_IMAP_MAILBOX=INBOX
TICKET_INBOUND_POLL_INTERVAL_MS=60000
TICKET_INBOUND_MAX_EMAILS_PER_RUN=20
TICKET_INBOUND_TIMEZONE=America/Santiago
TICKET_INBOUND_ALLOWED_SENDER_EMAILS=
TICKET_INBOUND_ALLOWED_SENDER_DOMAINS=
TICKET_INBOUND_FALLBACK_CLIENT_ID=CM-LOCAL
TICKET_INBOUND_FALLBACK_CREATOR_ID=1
TICKET_INBOUND_DEFAULT_TECHNICIANS=Mesa de ayuda
TICKET_INBOUND_USE_SENDER_ACCOUNT_AS_CREATOR=false
TICKET_INBOUND_MARK_SEEN_ON_ERROR=true
TICKET_INBOUND_ARCHIVE_MAILBOX=Procesados
TICKET_INBOUND_CRON_EXPRESSION=*/5 * * * *

# SMTP local/deshabilitado
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

TICKET_OUTBOUND_SMTP_HOST=localhost
TICKET_OUTBOUND_SMTP_PORT=1025
TICKET_OUTBOUND_SMTP_SECURE=false
TICKET_OUTBOUND_SMTP_USER=
TICKET_OUTBOUND_SMTP_PASSWORD=
TICKET_OUTBOUND_FROM_ADDRESS=no-reply@local.dev
TICKET_OUTBOUND_FROM_NAME=Mesa de Ayuda Local

TICKET_INBOUND_NO_REPLY_EMAILS=
TICKET_INBOUND_NO_REPLY_DOMAINS=
