NODE_ENV=demo
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE_NAME=soporte_siroe_demo
DB_USER=demo_user
DB_PASSWORD=demo_password

JWT_SECRETPASSWORD=demo-secret-key

GCLOUD_PROJECT_ID=demo-project
GCLOUD_KEY_FILE=./config/demo-service-account.json
GCLOUD_BUCKET_NAME=soporte-siroe-demo

TICKET_INBOUND_ENABLED=false
TICKET_INBOUND_IMAP_HOST=imap.demo.local
TICKET_INBOUND_IMAP_PORT=993
TICKET_INBOUND_IMAP_SECURE=true
TICKET_INBOUND_IMAP_USER=demo@siroe.cl
TICKET_INBOUND_IMAP_PASSWORD=demo-secret
TICKET_INBOUND_IMAP_MAILBOX=INBOX
TICKET_INBOUND_POLL_INTERVAL_MS=60000
TICKET_INBOUND_MAX_EMAILS_PER_RUN=10
TICKET_INBOUND_DEFAULT_TECHNICIANS=Mesa Ayuda Demo,Rodrigo Cárdenas
TICKET_INBOUND_FALLBACK_CLIENT_ID=CM-ALBATROS
TICKET_INBOUND_FALLBACK_CREATOR_ID=1
TICKET_INBOUND_USE_SENDER_ACCOUNT_AS_CREATOR=false
TICKET_INBOUND_MARK_SEEN_ON_ERROR=false
TICKET_INBOUND_ALLOWED_SENDER_EMAILS=
TICKET_INBOUND_ALLOWED_SENDER_DOMAINS=
TICKET_INBOUND_ARCHIVE_MAILBOX=
TICKET_INBOUND_TIMEZONE=America/Santiago
TICKET_INBOUND_CRON_EXPRESSION=*/10 * * * *

TICKET_OUTBOUND_ENABLED=false
TICKET_OUTBOUND_SMTP_HOST=smtp.demo.local
TICKET_OUTBOUND_SMTP_PORT=465
TICKET_OUTBOUND_SMTP_SECURE=true
TICKET_OUTBOUND_SMTP_USER=demo@siroe.cl
TICKET_OUTBOUND_SMTP_PASSWORD=demo-secret
TICKET_OUTBOUND_FROM_ADDRESS=mesa.demo@siroe.cl
TICKET_OUTBOUND_FROM_NAME=Demo Mesa de Ayuda
TICKET_OUTBOUND_SUBJECT_PREFIX=[Demo Ticket]
TICKET_OUTBOUND_ACK_TEMPLATE=Hola {{nombre}}, tu ticket demo fue recibido.

FRONTEND_URL=https://demo.soportesiroe.cl
ALLOW_ORIGIN=https://demo.soportesiroe.cl
